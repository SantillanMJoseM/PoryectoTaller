# Sistema Taller — variables de entorno (plantilla)
# Copie a .env.local (git-ignorado). Solo variables con prefijo VITE_ llegan
# al bundle del frontend; NO coloque service_role ni secretos SMTP aquí.
# Valores locales por defecto si usa `supabase start`:
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=ponga-su-anon-key

# Opcional — desactivar el autoproceso de la cola de emails en el navegador
# (por defecto activado). Valores: cualquier valor distinto de "false" = activo.
# VITE_EMAILS_AUTO_PROCESAR=false
