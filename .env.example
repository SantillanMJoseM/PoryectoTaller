# ============================================================================
# Sistema Taller — Plantilla de variables de entorno (TASK-0014 / AG-016)
# ============================================================================
# Copia este archivo como `.env.local` (no se sube al repositorio) y completa
# los valores con los de TU proyecto de Supabase.
#
#   cp .env.example .env.local
#
# Reglas de seguridad (SOURCE_PROMPT.md «Seguridad»):
#   • Solo variables con prefijo VITE_ son legibles por el frontend: nunca
#     coloques claves privadas (service_role / secretos SMTP) en este archivo.
#   • La anon key es pública por diseño; su acceso se controla con Row Level
#     Security en PostgreSQL (ver supabase/migrations/0003_rls.sql).
#   • Este archivo NO contiene valores reales: reemplaza los marcadores.
# ============================================================================

# URL del proyecto Supabase (Dashboard → Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave anónima (Dashboard → Project Settings → API → anon public). Es pública
# por diseño: el acceso real a datos se restringe con políticas RLS.
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA
